use std.runtime;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A:    std.allocator;
use page: std.allocator.page;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val count: usize = 1024;

    # create a page-backed allocator
    var a: A.Allocator;
    page.make(?a);

    # allocate a buffer using the canonical allocator interface
    val r: res[*u8, A.Error] = A.allocate[u8](?a, count);
    if (sel r.err) {
        ret 1;
    }
    val buf: *u8 = r.ok;

    # the same allocator frees exactly what it allocated
    val released: err[A.Error] = A.deallocate[u8](?a, buf, count);
    if (sel released.err) {
        ret 1;
    }

    ret 0;
}

use parse: std.text.parse;
use std.print.printf;
use std.runtime;
use std.types.result.res;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # a fallible call returns a tag value, not a thrown exception
    val r: res[u64, parse.ParseError] = parse.parse_u64(argv[1], 10);

    # sel checks the active case and guards access to the payload
    if (sel r.err) {
        printf("failed to parse integer\n");
        ret 1;
    }

    # r.ok is readable because the error branch exited
    val limit: u64 = r.ok;
    printf("limit = {}\n", limit);

    ret 0;
}

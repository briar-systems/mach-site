use std.runtime;
use std.print.printf;
use std.types.bool.bool;

# `^u64` is a secret. the compiler tracks where it flows and refuses any
# operation an observer could learn it from: a branch, a memory index, an
# address, or an instruction whose timing depends on the value.
#[oblivious]
fun ct_diff(a: ^u64, b: ^u64) ^u64 {
    ret a ^ b;                 # one xor, always the same work
}

fun verify(given: ^u64, secret: ^u64) bool {
    # if (given == secret) { ... }   <- refused: a secret cannot decide a branch
    # `:^` is the one explicit way out, so disclosure is always deliberate
    ret (ct_diff(given, secret):^) == 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val key: ^u64 = 0xA5A5A5A5;
    printf("right guess: {}\n", verify(0xA5A5A5A5, key));
    printf("wrong guess: {}\n", verify(0xDEADBEEF, key));
    ret 0;
}

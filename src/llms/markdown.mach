# mach's doc/language markdown, as llms-full.txt carries it
#
# the reference follows the order its README.md links the files in. each file
# is trimmed, its relative links are rewritten to absolute github urls at the
# release tag, and its headings are demoted to nest under the reference's own
# heading. fenced blocks are left alone, and so are code spans, whose links are
# not links. these are the transforms the site's deploy-time build applied.

use site.text;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

val HOST:     str = "https://github.com";
val REPO:     str = "briar-systems/mach";
val LANG_DIR: str = "doc/language";
# how far a reference heading is demoted, so its h1 nests under the ## heading
val SHIFT: usize = 2;
# the deepest link path a reference file may resolve to
val MAX_SEGMENTS: usize = 64;

val PART_PATH:     u8 = 0;
val PART_QUERY:    u8 = 1;
val PART_FRAGMENT: u8 = 2;

fun is_space(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12;
}

fun at(value: view.View, index: usize) u8 {
    ret value.data[index]::u8;
}

fun slice(value: view.View, start: usize, end: usize) view.View {
    ret view.view(?value.data[start], end - start);
}

# the value without the whitespace around it
pub fun trim(value: view.View) view.View {
    var start: usize = 0;
    var end:   usize = value.len;
    for (start < end && is_space(at(value, start))) { start = start + 1; }
    for (end > start && is_space(at(value, end - 1))) { end = end - 1; }
    ret slice(value, start, end);
}

fun name_byte(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
        || c == '-';
}

# the .md files an index links, in order, the first mention of each winning.
# a link is `](name.md)` or `](name.md#anchor)`, anywhere in the text
# ---
# index:  the index's text
# output: storage for the names, as views into `index`
# cap:    how many names `output` holds
# ret:    how many names the index links, which may exceed `cap`
pub fun index_order(index: view.View, output: *view.View, cap: usize) usize {
    var count: usize = 0;
    var i:     usize = 0;
    for (i + 1 < index.len) {
        if (at(index, i) != ']' || at(index, i + 1) != '(') {
            i = i + 1;
            cnt;
        }
        val start: usize = i + 2;
        var end:   usize = start;
        for (end < index.len && name_byte(at(index, end))) { end = end + 1; }
        var close: usize = end + 3;
        if (end == start || close > index.len
            || !text.same(slice(index, end, close), text.text(".md"))) {
            i = i + 1;
            cnt;
        }
        if (close < index.len && at(index, close) == '#') {
            for (close < index.len && at(index, close) != ')') { close = close + 1; }
        }
        if (close >= index.len || at(index, close) != ')') {
            i = i + 1;
            cnt;
        }
        val name: view.View = slice(index, start, end + 3);
        var seen: bool      = false;
        var j:    usize     = 0;
        for (j < count && j < cap) {
            if (text.same(output[j], name)) { seen = true; }
            j = j + 1;
        }
        if (!seen) {
            if (count < cap) { output[count] = name; }
            count = count + 1;
        }
        i = close + 1;
    }
    ret count;
}

# the fenced block a line is in, if any
pub rec Fence {
    open: bool;
    mark: u8;
    len:  usize;
}

pub fun no_fence() Fence {
    ret Fence{open: false, mark: 0, len: 0};
}

# the length of the run of three or more backticks or tildes a line opens with,
# after whitespace, and where it starts, or 0 for a line that opens with none
fun fence_run(line: view.View, start: *usize) usize {
    var first: usize = 0;
    for (first < line.len && is_space(at(line, first))) { first = first + 1; }
    if (first == line.len) { ret 0; }
    val mark: u8 = at(line, first);
    if (mark != '`' && mark != '~') { ret 0; }
    var end: usize = first;
    for (end < line.len && at(line, end) == mark) { end = end + 1; }
    if (end - first < 3) { ret 0; }
    @start = first;
    ret end - first;
}

# whether a line is prose, outside every fenced block, moving `fence` past it.
# a run opens a block, and only a line holding nothing but a run of the same
# mark, at least as long, closes it
pub fun prose(line: view.View, fence: *Fence) bool {
    var start: usize = 0;
    val run:   usize = fence_run(line, ?start);
    if (!fence.open) {
        if (run == 0) { ret true; }
        @fence = Fence{open: true, mark: at(line, start), len: run};
        ret false;
    }
    if (run != 0 && at(line, start) == fence.mark && run >= fence.len
        && trim(slice(line, start + run, line.len)).len == 0) { @fence = no_fence(); }
    ret false;
}

fun backticks(line: view.View, start: usize, count: usize) bool {
    if (start + count > line.len) { ret false; }
    var i: usize = 0;
    for (i < count) {
        if (at(line, start + i) != '`') { ret false; }
        i = i + 1;
    }
    ret true;
}

# the end of the code span that opens at `start`, or 0 when none does. the
# span closes at the first later run of as many backticks as it opened with,
# and when none is found it tries opening with fewer
fun code_span(line: view.View, start: usize) usize {
    var run: usize = 0;
    for (start + run < line.len && at(line, start + run) == '`') { run = run + 1; }
    for (run > 0) {
        var p: usize = start + run;
        for (p + run <= line.len) {
            if (backticks(line, p, run)) { ret p + run; }
            p = p + 1;
        }
        run = run - 1;
    }
    ret 0;
}

fun hex(value: u8) u8 {
    if (value < 10) { ret ('0'::u8) + value; }
    ret ('A'::u8) + value - 10;
}

# a url part percent-encoded as a browser encodes the same part
fun put_encoded(b: *text.Buf, value: view.View, part: u8) {
    var i: usize = 0;
    for (i < value.len) {
        val c:       u8   = at(value, i);
        var escaped: bool = c <= 32 || c >= 127 || c == '"' || c == '<' || c == '>';
        if (part == PART_PATH)  { escaped = escaped || c == '`' || c == '{' || c == '}'; }
        or (part == PART_QUERY) { escaped = escaped || c == '\''; }
        or                      { escaped = escaped || c == '`'; }
        if (escaped) {
            text.put_byte(b, '%');
            text.put_byte(b, hex(c >> 4));
            text.put_byte(b, hex(c & 15));
        }
        or { text.put_byte(b, c); }
        i = i + 1;
    }
}

fun has_scheme(href: view.View) bool {
    if (href.len == 0) { ret false; }
    val first: u8 = text.lower(at(href, 0));
    if (first < 'a' || first > 'z') { ret false; }
    var i: usize = 1;
    for (i < href.len) {
        val c: u8 = text.lower(at(href, i));
        if (c == ':') { ret true; }
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '+' || c == '.'
            || c == '-')) { ret false; }
        i = i + 1;
    }
    ret false;
}

# the path segments of a resolved url, as views into the parts it came from
rec Segments {
    items: [MAX_SEGMENTS]view.View;
    len:   usize;
    ok:    bool;
}

fun push(segments: *Segments, value: view.View) {
    if (segments.len == MAX_SEGMENTS) {
        segments.ok = false;
        ret;
    }
    segments.items[segments.len] = value;
    segments.len                 = segments.len + 1;
}

fun push_str(segments: *Segments, value: str) {
    push(segments, text.text(value));
}

# the segments of the directory a reference file sits in
fun push_base(segments: *Segments, tag: view.View) {
    push_str(segments, "briar-systems");
    push_str(segments, "mach");
    push_str(segments, "blob");
    push(segments, tag);
    push_str(segments, "doc");
    push_str(segments, "language");
}

# a relative path's segments on top of `segments`, with . and .. resolved
fun push_path(segments: *Segments, path: view.View) {
    var start: usize = 0;
    var i:     usize = 0;
    for (i <= path.len) {
        if (i < path.len && at(path, i) != '/' && at(path, i) != '\\') {
            i = i + 1;
            cnt;
        }
        val segment: view.View = slice(path, start, i);
        val last:    bool      = i == path.len;
        if (text.same(segment, text.text(".."))) {
            if (segments.len > 0) { segments.len = segments.len - 1; }
            if (last)             { push(segments, view.view(nil, 0)); }
        }
        or (text.same(segment, text.text("."))) {
            if (last) { push(segments, view.view(nil, 0)); }
        }
        or { push(segments, segment); }
        start = i + 1;
        i     = i + 1;
    }
}

# `href`, a link in doc/language/`file` at `tag`, as an absolute url. it
# resolves as a browser resolves it against the file's page on github
# ---
# ret: whether the url could be resolved
fun put_url(b: *text.Buf, href: view.View, file: view.View, tag: view.View) bool {
    if (has_scheme(href)) {
        text.put(b, href);
        ret true;
    }
    if (at(href, 0) == '#') {
        text.put_str(b, HOST);
        text.put_byte(b, '/');
        text.put_str(b, REPO);
        text.put_str(b, "/blob/");
        text.put(b, tag);
        text.put_byte(b, '/');
        text.put_str(b, LANG_DIR);
        text.put_byte(b, '/');
        text.put(b, file);
        text.put(b, href);
        ret true;
    }
    if (href.len >= 2 && at(href, 0) == '/' && at(href, 1) == '/') {
        text.put_str(b, "https:");
        text.put(b, href);
        ret true;
    }
    var path_end: usize = 0;
    for (path_end < href.len && at(href, path_end) != '?' && at(href, path_end) != '#') {
        path_end = path_end + 1;
    }
    var query_end: usize = path_end;
    for (query_end < href.len && at(href, query_end) != '#') { query_end = query_end + 1; }
    val path:     view.View = slice(href, 0, path_end);
    var segments: Segments;
    segments.len = 0;
    segments.ok  = true;
    if (path.len == 0) {
        push_base(?segments, tag);
        push(?segments, file);
    }
    or (at(path, 0) == '/' || at(path, 0) == '\\') {
        push_path(?segments, slice(path, 1, path.len));
    }
    or {
        push_base(?segments, tag);
        push_path(?segments, path);
    }
    if (!segments.ok) { ret false; }
    text.put_str(b, HOST);
    if (segments.len == 0) { text.put_byte(b, '/'); }
    var i: usize = 0;
    for (i < segments.len) {
        text.put_byte(b, '/');
        put_encoded(b, segments.items[i], PART_PATH);
        i = i + 1;
    }
    put_encoded(b, slice(href, path_end, query_end), PART_QUERY);
    put_encoded(b, slice(href, query_end, href.len), PART_FRAGMENT);
    ret true;
}

# prose with every `](href)` link target made absolute
fun put_links(b: *text.Buf, prose: view.View, file: view.View, tag: view.View) bool {
    var i: usize = 0;
    for (i < prose.len) {
        if (at(prose, i) == ']' && i + 1 < prose.len && at(prose, i + 1) == '(') {
            var end: usize = i + 2;
            for (end < prose.len && at(prose, end) != ')' && !is_space(at(prose, end))) {
                end = end + 1;
            }
            if (end > i + 2 && end < prose.len && at(prose, end) == ')') {
                text.put_str(b, "](");
                if (!put_url(b, slice(prose, i + 2, end), file, tag)) { ret false; }
                text.put_byte(b, ')');
                i = end + 1;
                cnt;
            }
        }
        text.put_byte(b, at(prose, i));
        i = i + 1;
    }
    ret true;
}

# one prose line, its heading demoted and the links outside its code spans
# made absolute
fun put_prose(b: *text.Buf, line: view.View, file: view.View, tag: view.View) bool {
    var level: usize = 0;
    for (level < line.len && at(line, level) == '#') { level = level + 1; }
    var start: usize = 0;
    if (level >= 1 && level <= 6 && level < line.len && is_space(at(line, level))) {
        var shifted: usize = level + SHIFT;
        if (shifted > 6) { shifted = 6; }
        var i: usize = 0;
        for (i < shifted) {
            text.put_byte(b, '#');
            i = i + 1;
        }
        start = level;
    }
    var from: usize = start;
    var i:    usize = start;
    for (i < line.len) {
        if (at(line, i) != '`') {
            i = i + 1;
            cnt;
        }
        val end: usize = code_span(line, i);
        if (end == 0) {
            i = i + 1;
            cnt;
        }
        if (!put_links(b, slice(line, from, i), file, tag)) { ret false; }
        text.put(b, slice(line, i, end));
        from = end;
        i    = end;
    }
    ret put_links(b, slice(line, from, line.len), file, tag);
}

# one reference file as llms-full.txt carries it: its source line, then its
# text, trimmed, with its links made absolute and its headings demoted
# ---
# b:    where it is written
# name: the file's name in doc/language, such as types.md
# body: the file's text
# tag:  the release tag it was read at, such as v6.7.0
# ret:  whether every link could be resolved
pub fun put_reference(b: *text.Buf, name: view.View, body: view.View, tag: view.View) bool {
    text.put_str(b, "Source: ");
    text.put_str(b, HOST);
    text.put_byte(b, '/');
    text.put_str(b, REPO);
    text.put_str(b, "/blob/");
    text.put(b, tag);
    text.put_byte(b, '/');
    text.put_str(b, LANG_DIR);
    text.put_byte(b, '/');
    text.put(b, name);
    text.put_str(b, "\n\n");
    val content: view.View = trim(body);
    var fence:   Fence     = no_fence();
    var start:   usize     = 0;
    var i:       usize     = 0;
    for (i <= content.len) {
        if (i < content.len && at(content, i) != '\n') {
            i = i + 1;
            cnt;
        }
        val line: view.View = slice(content, start, i);
        if (prose(line, ?fence)) {
            if (!put_prose(b, line, name, tag)) { ret false; }
        }
        or                   { text.put(b, line); }
        if (i < content.len) { text.put_byte(b, '\n'); }
        start = i + 1;
        i     = i + 1;
    }
    text.put_byte(b, '\n');
    ret true;
}

fun matches(name: str, body: str, want: str) bool {
    var storage: [4096]u8;
    var b:       text.Buf = text.buf(?storage[0], 4096);
    if (!put_reference(?b, text.text(name), text.text(body), text.text("v1.2.3"))) {
        ret false;
    }
    ret text.fits(?b) && text.same(text.written(?b), text.text(want));
}

test index_order__first_mention_wins {
    var names: [8]view.View;
    val count: usize = index_order(text.text(
        "- [a](a.md)\n- [b](b.md#x)\n- [a again](a.md)\n- [ext](https://x.org/c.md)\n- [d](d.txt)"),
        ?names[0], 8);
    if (count != 2)                              { ret 1; }
    if (!text.same(names[0], text.text("a.md"))) { ret 2; }
    if (!text.same(names[1], text.text("b.md"))) { ret 3; }
    ret 0;
}

test put_reference__links_outside_code_become_absolute {
    if (!matches("fun.md",
        "[f](files.md#x) and [here](#y) and [t](../../test/README.md) and [w](https://x.org/a)",
        "Source: https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/fun.md\n\n[f](https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/files.md#x) and [here](https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/fun.md#y) and [t](https://github.com/briar-systems/mach/blob/v1.2.3/test/README.md) and [w](https://x.org/a)\n")) {
        ret 1;
    }
    if (!matches("fun.md", "`identity[i64](42)` and ``a`](b.md)`` stay",
        "Source: https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/fun.md\n\n`identity[i64](42)` and ``a`](b.md)`` stay\n")) {
        ret 2;
    }
    if (!matches("fun.md", "[r](/briar-systems/mach/./a/../b{c}) [s](./x/y.md?q=a'b#z<) [u](../..) [v](?q)",
        "Source: https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/fun.md\n\n[r](https://github.com/briar-systems/mach/b%7Bc%7D) [s](https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/x/y.md?q=a%27b#z%3C) [u](https://github.com/briar-systems/mach/blob/v1.2.3/) [v](https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/fun.md?q)\n")) {
        ret 3;
    }
    ret 0;
}

test put_reference__headings_demote_outside_fences {
    if (!matches("a.md", "\n\n# A\n```mach\n# comment\n[a](b)\n```\n## B\n####### G\n#no\n\n",
        "Source: https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/a.md\n\n### A\n```mach\n# comment\n[a](b)\n```\n#### B\n####### G\n#no\n")) {
        ret 1;
    }
    if (!matches("a.md", "~~~~\n# in\n~~~\n```\n# still in\n~~~~ \n##### F",
        "Source: https://github.com/briar-systems/mach/blob/v1.2.3/doc/language/a.md\n\n~~~~\n# in\n~~~\n```\n# still in\n~~~~ \n###### F\n")) {
        ret 2;
    }
    ret 0;
}

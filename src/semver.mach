# a release's three numbers, and which of two releases is newer

use site.text;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;
use std.types.view;

# the three numbers of an X.Y.Z version into `output`, or false for anything
# else: a prerelease, a partial version, a number of ten digits or more
pub fun parse(value: view.View, output: *u64) bool {
    var part: usize = 0;
    var at:   usize = 0;
    for (part < 3) {
        var number: u64   = 0;
        val start:  usize = at;
        for (at < value.len && value.data[at]::u8 >= '0' && value.data[at]::u8 <= '9') {
            number = number * 10 + (value.data[at]::u8 - '0')::u64;
            at     = at + 1;
        }
        if (at == start || at - start > 9) { ret false; }
        output[part] = number;
        part         = part + 1;
        if (part < 3) {
            if (at >= value.len || value.data[at]::u8 != '.') { ret false; }
            at = at + 1;
        }
    }
    ret at == value.len;
}

# whether the release at `a` is newer than the one at `b`
pub fun newer(a: *u64, b: *u64) bool {
    var i: usize = 0;
    for (i < 3) {
        if (a[i] != b[i]) { ret a[i] > b[i]; }
        i = i + 1;
    }
    ret false;
}

test parse__only_a_plain_release {
    var parts: [3]u64;
    if (!parse(text.text("7.10.2"), ?parts[0]))           { ret 1; }
    if (parts[0] != 7 || parts[1] != 10 || parts[2] != 2) { ret 2; }
    if (parse(text.text("7.3"), ?parts[0]))               { ret 3; }
    if (parse(text.text("7.3.0-rc.1"), ?parts[0]))        { ret 4; }
    if (parse(text.text("7..0"), ?parts[0]))              { ret 5; }
    if (parse(text.text("7.3.0.1"), ?parts[0]))           { ret 6; }
    if (parse(text.text("1234567890.0.0"), ?parts[0]))    { ret 7; }
    ret 0;
}

test newer__by_number_not_by_text {
    var a: [3]u64 = [3]u64{7, 10, 0};
    var b: [3]u64 = [3]u64{7, 9, 1};
    if (!newer(?a[0], ?b[0])) { ret 1; }
    if (newer(?b[0], ?a[0]))  { ret 2; }
    if (newer(?a[0], ?a[0]))  { ret 3; }
    ret 0;
}
